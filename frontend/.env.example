# Supabase — get from dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq AI grading — https://console.groq.com
GROQ_API_KEY=

# App config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WORKERSHUB_URL=http://localhost:3001
NEXT_PUBLIC_PASS_SCORE=70
NEXT_PUBLIC_QUESTION_COUNT=25
NEXT_PUBLIC_TIME_LIMIT=40

# ─── v4 new-domain feature flags (unset = on; set false to hide) ──
NEXT_PUBLIC_TRACK_EPSILON=true
NEXT_PUBLIC_TRACK_ZETA=true
NEXT_PUBLIC_TRACK_ETA=true
NEXT_PUBLIC_TRACK_THETA=true
NEXT_PUBLIC_FEATURE_PROFICIENCY_GATE=true
# Optional: require this exam before gated types (default gated type: theta)
NEXT_PUBLIC_REQUIRED_PROFICIENCY_EXAM=
NEXT_PUBLIC_PROFICIENCY_GATED_TYPES=theta

# Paystack — https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Plan codes created in the Paystack dashboard (Products -> Plans) — paste
# into billing_plans.paystack_plan_code (migration 022), not read from env
# at runtime.
PAYSTACK_PLAN_CODE_PRO=
PAYSTACK_PLAN_CODE_ELITE=
# Card-verification charge amount in kobo, refunded immediately after use —
# see lib/paystack.ts for why a subscription needs one prior charge.
PAYSTACK_TRIAL_VERIFICATION_AMOUNT_KOBO=10000
