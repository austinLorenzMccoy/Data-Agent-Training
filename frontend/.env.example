# Supabase — get from dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq AI grading — https://console.groq.com
GROQ_API_KEY=

# App config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WORKERSHUB_URL=http://localhost:3001
NEXT_PUBLIC_PASS_SCORE=70
NEXT_PUBLIC_QUESTION_COUNT=25
NEXT_PUBLIC_TIME_LIMIT=40

# ─── v4 new-domain feature flags (unset = on; set false to hide) ──
NEXT_PUBLIC_TRACK_EPSILON=true
NEXT_PUBLIC_TRACK_ZETA=true
NEXT_PUBLIC_TRACK_ETA=true
NEXT_PUBLIC_TRACK_THETA=true
NEXT_PUBLIC_FEATURE_PROFICIENCY_GATE=true
# Optional: require this exam before gated types (default gated type: theta)
NEXT_PUBLIC_REQUIRED_PROFICIENCY_EXAM=
NEXT_PUBLIC_PROFICIENCY_GATED_TYPES=theta

# Paystack — https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Plan codes created in the Paystack dashboard (Products -> Plans) — paste
# into billing_plans.paystack_plan_code (migration 022), not read from env
# at runtime.
PAYSTACK_PLAN_CODE_PRO=
PAYSTACK_PLAN_CODE_ELITE=
# Card-verification charge amount in kobo, refunded immediately after use —
# see lib/paystack.ts for why a subscription needs one prior charge.
PAYSTACK_TRIAL_VERIFICATION_AMOUNT_KOBO=10000

# ─── Server-scored tests, hiring and operations (migrations 027–029) ──
# Comma-separated emails of platform staff: /admin, question bank, all grade reviews.
ADMIN_EMAILS=
# true lets any signed-in user create an organisation; otherwise only ADMIN_EMAILS can.
ORG_SELF_SERVE=false
# Optional cap on learner attempts per task type (organisation exams set their own).
EXAM_MAX_ATTEMPTS_PER_TRACK=
# Model used to grade written reasons (Groq).
GRADER_MODEL=openai/gpt-oss-20b
# Rate limits (Upstash Redis REST). Unset = no rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Slack or Discord incoming webhook for server errors and Paystack/webhook failures.
ALERT_WEBHOOK_URL=
# Shared with the GitHub "Housekeeping" workflow (repo secret CRON_SECRET).
CRON_SECRET=
# Shown on the privacy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Manual payments (migration 030) ──
# Where learners send money. A method with no value is hidden.
# Also set a USD price per plan in Supabase:
#   update billing_plans set price_usd_cents = 500 where slug = 'pro';
MANUAL_PAY_AIRTM=          # your Airtm email or username
MANUAL_PAY_BINANCE=        # your Binance Pay ID
MANUAL_PAY_GREY=           # your Grey USD account details or Grey tag

# Premium members' WhatsApp group invite link, shown only to paid members
# on /premium. Leave empty to show "link coming soon".
PREMIUM_WHATSAPP_URL=

# Free public Telegram community, linked from the footer and /premium.
# Leave empty to hide the links.
NEXT_PUBLIC_TELEGRAM_URL=
